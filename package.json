{
  "name": "utas-pax-demo",
  "version": "1.0.0",
  "description": "Pax Demo Standalone Launcher",
  "main": "launcher.js",
  "bin": "launcher.js",
  "scripts": {
    "start": "node launcher.js",
    "build:flutter": "cd utas_pax_demo_flutter && flutter build web --release",
    "package:macos": "pkg . --targets node18-macos-arm64 --output \"dist/Pax Demo\" --public",
    "package:windows": "pkg . --targets node18-win-x64 --output dist/pax-demo.exe --public",
    "build": "npm run build:flutter && npm run package:macos"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "portfinder": "^1.0.32"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "utas_pax_demo_api/games/**/*",
      "utas_pax_demo_flutter/build/web/**/*"
    ]
  }
}
